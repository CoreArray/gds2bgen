####################################################################
###                          gds2bgen                            ###
###                                                              ###

# download the bgen library from
# https://enkre.net/cgi-bin/code/bgen/dir?ci=release
BGEN_DIR = bgen_v1.1.8

# additional preprocessor options
# -DHAVE_ZLIB enables the compressed-block writer in the header-only bgen API
# (genfile/bgen/bgen.hpp); without it the GDS->BGEN compression path is disabled.
PKG_CPPFLAGS = -I$(BGEN_DIR)/genfile/include -I$(BGEN_DIR)/3rd_party/zstd-1.1.0/lib -DHAVE_ZLIB=1

# to set flags for the linker
PKG_LIBS = libbgen.a libzstd.a

# using C++11
CXX_STD = CXX11

SOURCES = R_gds2bgen.c gds2bgen.cpp
OBJECTS = R_gds2bgen.o gds2bgen.o

# detect Python version (prefers python3, then python2)
PYTHON := $(shell command -v python3 || command -v python2 || echo "python")


all: $(BGEN_DIR) $(SHLIB)

$(BGEN_DIR):
	unzip $(BGEN_DIR).zip

$(SHLIB): libbgen.a libzstd.a


libbgen.a: $(BGEN_DIR)
	@echo "Python: $(PYTHON)"
	@echo "CC = ${CC}"
	@echo "CXX = ${CXX}"
	cd $(BGEN_DIR) && $(PYTHON) ./waf configure --check-c-compiler="${CC}" --check-cxx-compiler="${CXX}" && $(PYTHON) ./waf
	cp -f $(BGEN_DIR)/build/libbgen.a .
	cp -f $(BGEN_DIR)/build/3rd_party/zstd-1.1.0/libzstd.a .
	rm -rf $(BGEN_DIR)/build


clean:
	rm -f $(OBJECTS)
	rm -f libbgen.a
	rm -f libzstd.a
	rm -rf $(BGEN_DIR)
